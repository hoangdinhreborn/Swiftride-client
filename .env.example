# URL của ứng dụng Web Client (Next.js 16.4.3)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL duy nhất kết nối tới hệ thống Backend (API Gateway YARP)
API_GATEWAY_URL=http://localhost:5000

# Goong.io Map & Places API Keys (Đăng ký miễn phí tại https://goong.io/)
# - Map Key (Tiles): Hiển thị bản đồ giao thông Việt Nam tiếng Việt
# - API Key (REST): Gợi ý địa chỉ Autocomplete và Geocoding
NEXT_PUBLIC_GOONG_MAP_KEY=
NEXT_PUBLIC_GOONG_API_KEY=
