# Base URL của ứng dụng Client (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL của API Gateway (Tất cả request BFF đều proxy sang Gateway)
API_GATEWAY_URL=http://localhost:5000

# Fallback direct services URL (Nếu chạy dev không dùng gateway)
TRIP_SERVICE_URL=http://localhost:5130
MATCHING_SERVICE_URL=http://localhost:5197
PAYMENT_SERVICE_URL=http://localhost:5273
